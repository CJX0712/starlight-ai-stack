# Starlight AI Stack 环境变量样例 · 作者 晨星
# 复制为 .env 后按需修改，也可直接设置同名环境变量

# 档位：high(7B+bge-m3) / balanced(默认) / lite
STARLIGHT_PROFILE=balanced

# 模型服务地址（Ollama 默认端口）
STARLIGHT_OLLAMA_URL=http://127.0.0.1:11434

# 数据目录：数据库与索引都放在这里
STARLIGHT_HOME=./data

# 切块参数（中文建议 300-500 字，重叠 60-100 字）
STARLIGHT_CHUNK_SIZE=420
STARLIGHT_CHUNK_OVERLAP=80

# 检索参数
STARLIGHT_TOP_K=5
STARLIGHT_CANDIDATE_K=20
STARLIGHT_RRF_K=60

# 服务端口
STARLIGHT_API_HOST=127.0.0.1
STARLIGHT_API_PORT=8787

# 超时（CPU 推理较慢，默认 300 秒）
STARLIGHT_TIMEOUT=300
